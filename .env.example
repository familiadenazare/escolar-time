# EscolarTime — variáveis de ambiente (sem Supabase)

# Postgres do Coolify. Em desenvolvimento: pglite:./.data/pglite (ver scripts/dev-db.mjs)
DATABASE_URL=postgres://usuario:senha@host:5432/escolartime

# Assinatura do cookie de sessão (mínimo 32 caracteres; gere com: openssl rand -hex 32)
SESSION_SECRET=

# Login com Google (cliente OAuth do Colégio). Redirecionamento autorizado: <APP_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Endereço público do app (o mesmo cadastrado no Google), ex.: https://horarios.familiadenazare.com.br
APP_URL=

# Só em desenvolvimento: libera /auth/dev?email=... (ignorado em produção)
DEV_LOGIN=
